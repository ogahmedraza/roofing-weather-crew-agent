      "typeVersion": 1,
      "position": [
        840,
        -100
      ],
      "id": "914a0944-abd7-4ba9-b2e4-258f4ced6f44",
      "name": "OpenWeatherMap - Forecast",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1200,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a roofing operations weather-risk assistant.\nReturn JSON only:\n{\"risk\":\"safe|review|high\",\"confidence\":0-100,\"summary\":\"...\",\"crew_message\":\"...\",\"affected_jobs\":[]}\nUse only supplied jobs/weather. Never invent facts. Never move/cancel jobs.\nHigh risk: rain, thunderstorm, severe weather, or strong wind overlapping roofing work.\nIf uncertain or confidence <80, use review."
            },
            {
              "role": "user",
              "content": "=JOBS:\n{{ JSON.stringify($('Prepare Jobs').item.json.jobs) }}\n\nFORECAST:\n{{ JSON.stringify($json) }}"
            }
          ]
        },
        "simplifyOutput": true,
        "options": {
          "temperature": 0.1,
          "maxTokens": 1000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1080,
        -100
      ],
      "id": "02076b9c-2853-4767-9722-dcac1809dfcd",
      "name": "OpenAI - Weather Risk",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nlet t=String($json.message?.content||$json.content||$json.text||'').trim();\nif(t.startsWith('```')) t=t.replace(/^```(?:json)?/i,'').replace(/```$/,'').trim();\nlet d; try{d=JSON.parse(t);}catch{throw new Error('Invalid AI JSON');}\nreturn [{json:{\n  risk:['safe','review','high'].includes(d.risk)?d.risk:'review',\n  confidence:Number(d.confidence||0),\n  summary:String(d.summary||''),\n  crew_message:String(d.crew_message||''),\n  affected_jobs:Array.isArray(d.affected_jobs)?d.affected_jobs:[]\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -100
      ],
      "id": "498dcd9b-ec8d-4bb6-8f98-3825b6912ffc",
      "name": "Parse Risk"
