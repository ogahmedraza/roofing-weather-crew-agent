        "chatId": "={{ $('Business Config').item.json.crew_chat_id }}",
        "text": "={{ 'ROOFING WEATHER ALERT\\nRisk: '+$('Parse Risk').item.json.risk.toUpperCase()+'\\nConfidence: '+$('Parse Risk').item.json.confidence+'%\\n\\n'+$('Parse Risk').item.json.crew_message+'\\n\\nAffected jobs:\\n'+JSON.stringify($('Parse Risk').item.json.affected_jobs,null,2)+'\\n\\nHuman review required before changing schedules.' }}",
