      "typeVersion": 2.3,
      "position": [
        -520,
        120
      ],
      "id": "6387dde2-6f20-435c-afde-b9664f63327c",
      "name": "Admin Command?"
    },
    {
      "parameters": {
        "jsCode": "\nconst msg=$('Telegram - Admin Control').item.json.message||{};\nconst admin=String($('Business Config').item.json.admin_chat_id||'');\nconst chat=String(msg.chat?.id||'');\nif(chat!==admin) return [{json:{reply:'Unauthorized'}}];\n\nconst text=String(msg.text||'').trim().toLowerCase();\nconst store=$getWorkflowStaticData('global');\nif(store.weatherPaused===undefined) store.weatherPaused=false;\n\nlet reply='Commands: /pause, /resume, /status';\nif(text==='/pause'){store.weatherPaused=true;reply='Weather automation paused.';}\nelse if(text==='/resume'){store.weatherPaused=false;reply='Weather automation resumed.';}\nelse if(text==='/status'){reply=store.weatherPaused?'Status: PAUSED':'Status: ACTIVE';}\nreturn [{json:{reply}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        380
      ],
      "id": "4a1a8db4-dde7-44ca-9cea-8ee8a15868b5",
      "name": "Handle Admin Command"
    },
    {
      "parameters": {
        "chatId": "={{ $('Business Config').item.json.admin_chat_id }}",
        "text": "={{ $json.reply }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -60,
        380
      ],
      "id": "afe1b29f-6af4-443a-918a-e4ff99ba6e45",
      "name": "Telegram - Admin Reply",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "\nconst store=$getWorkflowStaticData('global');\nif(store.weatherPaused===undefined) store.weatherPaused=false;\nreturn [{json:{paused:Boolean(store.weatherPaused)}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        -40
