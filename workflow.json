              "id": "b01bd6f8-4178-4bc2-8533-d35a19820be1",
              "leftValue": "={{ $json.risk !== 'safe' || $json.confidence < 80 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1560,
