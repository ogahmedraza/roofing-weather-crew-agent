    {
      "parameters": {
        "jsCode": "\nlet source='schedule';\ntry {\n  const x=$('Telegram - Admin Control').item.json;\n  if(x?.message) source='admin';\n} catch {}\nreturn [{json:{source}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
